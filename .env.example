# ==============================================================================
# QUANTUM TUMOR SENSING MACHINE — Environment Configuration Template
# Tagline: Intelligent Brain MRI Analysis & Tumor Classification Platform
# ==============================================================================

# FastAPI Application Settings
PROJECT_NAME="QUANTUM TUMOR SENSING MACHINE"
TAGLINE="Intelligent Brain MRI Analysis & Tumor Classification Platform"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000
SECRET_KEY="replace-this-with-a-secure-random-32-byte-hex-key"

# Database Configuration (PostgreSQL in Docker, SQLite locally)
# Local SQLite default:
DATABASE_URL="sqlite:///./quantum_tumor.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://quantum_user:quantum_secure_password@localhost:5432/quantum_tumor_db"

# Groq API Configuration (for live AI Clinical Assistant)
# Default model: llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Keras & Matplotlib isolated sandboxing (avoids writing to home directory)
KERAS_HOME=".keras_home"
MPLCONFIGDIR=".matplotlib_home"

# Frontend Environment Variables
NEXT_PUBLIC_API_URL="http://localhost:8000"
