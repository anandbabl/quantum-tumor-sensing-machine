# ==============================================================================
# QUANTUM TUMOR SENSING MACHINE — Production .gitignore
# ==============================================================================

# --- Environments & Secrets (CRITICAL SECURITY) ---
.env
.env*
!.env.example
*.env
*.pem
*.key
*.cert
*.pfx

# --- Python Virtual Environments & Dependencies ---
venv/
backend/venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Python Bytecode & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Isolated Keras & Matplotlib Homes ---
.keras_home/
backend/.keras_home/
.matplotlib_home/
backend/.matplotlib_home/

# --- Local Databases & Data Stores ---
*.db
*.sqlite
*.sqlite3
quantum_tumor.db
backend/quantum_tumor.db
backend/neuroscan.db

# --- User Uploads & Generated Outputs (Private Patient Data) ---
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep
backend/reports/*
!backend/reports/.gitkeep

# --- Node.js & Next.js Frontend ---
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

